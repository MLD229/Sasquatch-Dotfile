/* === SASQUATCH-PALETTE-BEGIN === */
* {
    /* ── Backgrounds ────────────────────────────────── */
    bg-window:   rgba(26, 21, 10, 0.85);
    bg-input:    rgba(28, 33, 38, 0.80);
    bg-selected: rgba(45, 129, 251, 0.25);
    urgent-bg:   rgba(243, 139, 168, 0.25);

    /* ── Foregrounds ────────────────────────────────── */
    fg:          rgba(217, 208, 189, 1.0);
    fg-dim:      rgba(131, 123, 108, 1.0);
    fg-selected: rgba(255, 255, 255, 1.0);

    /* ── Accents ────────────────────────────────────── */
    accent:      rgba(45, 129, 251, 1.0);
    accent-dim:  rgba(45, 129, 251, 0.75);
    urgent:      rgba(243, 139, 168, 1.0);

    /* ── Border ─────────────────────────────────────── */
    border:      rgba(45, 129, 251, 0.50);
}
/* === SASQUATCH-PALETTE-END === */
