/* === SASQUATCH-PALETTE-BEGIN === */
* {
    /* ── Backgrounds ────────────────────────────────── */
    bg-window:   rgba(19, 21, 30, 0.62);
    bg-input:    rgba(25, 19, 29, 0.55);
    bg-osd:      rgba(19, 21, 30, 0.88);
    bg-selected: rgba(89, 99, 113, 0.90);
    urgent-bg:   rgba(243, 139, 168, 0.85);

    /* ── Foregrounds ────────────────────────────────── */
    fg:          rgba(208, 208, 213, 1.0);
    fg-dim:      rgba(122, 123, 130, 1.0);
    fg-selected: rgba(255, 255, 255, 1.0);

    /* ── Accents ────────────────────────────────────── */
    accent:      rgba(175, 149, 155, 1.0);
    accent-dim:  rgba(175, 149, 155, 0.75);
    accent2:     rgba(89, 99, 113, 1.0);
    urgent:      rgba(243, 139, 168, 1.0);

    /* ── Border ─────────────────────────────────────── */
    border:      rgba(175, 149, 155, 0.50);
}
/* === SASQUATCH-PALETTE-END === */
