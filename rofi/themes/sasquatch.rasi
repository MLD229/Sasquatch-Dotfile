@import "colors.rasi"
/* ── Global ─────────────────────────────────────────── */
* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       var(fg);
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ── Window ───────────────────────────────────────────
   Fond translucide piloté par la palette (colors.rasi : bg-window α 0.62) :
   le flou/le wallpaper respire derrière, le texte reste lisible (fg plein).
   Avant : rgba(1, 22, 26, 0.97) en dur → aucune transparence possible. */
window {
    width:            680px;
    location:         center;
    anchor:           center;
    background-color: var(bg-window);
    border-radius:    20px;
    border:           1px;
    border-color:     var(border);
    padding:          14px;
}

/* ── Main Box ───────────────────────────────────────── */
mainbox {
    background-color: transparent;
    spacing:          10px;
    /* PAS de `children:` explicite ici : avec [inputbar, listview] le modi
       natif « calc » (plugin rofi-calc) perd sa ligne « Result: … » — mesuré.
       L'ordre par défaut (inputbar, message, listview) l'affiche. */
}

/* ── Input Bar ──────────────────────────────────────── */
inputbar {
    background-color: var(bg-input);
    border-radius:    12px;
    padding:          11px 14px;
    spacing:          8px;
    children:         [ prompt, textbox-prompt-colon, entry ];
}

prompt {
    background-color: transparent;
    text-color:       var(accent);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       var(accent-dim);
    str:              "›";
    expand:           false;
    margin:           0px 6px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       var(fg);
}

/* ── List View ──────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:          1;
    lines:            11;
    spacing:          3px;
    scrollbar:        false;
    dynamic:          true;
}

/* ── List Element ───────────────────────────────────── */
element {
    background-color: transparent;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          10px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    text-color: var(fg);
}

/* Sélection : fond accent2 de la palette (colors.rasi, α 0.90) + texte
   fg-selected — le générateur choisit un texte clair ou sombre selon la
   luminance d'accent2. Avant : teal rgba(6,102,120,0.90) en dur, qui ne
   suivait pas le thème. */
element selected.normal {
    background-color: var(bg-selected);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

element normal.urgent,
element alternate.urgent {
    text-color: var(urgent);
}

element selected.urgent {
    background-color: var(urgent-bg);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

element normal.active,
element alternate.active {
    text-color: var(fg);
}

element selected.active {
    background-color: var(bg-selected);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

/* ── Icon ───────────────────────────────────────────── */
element-icon {
    background-color: transparent;
    size:             24px;
}

/* ── Text ───────────────────────────────────────────── */
element-text {
    background-color: transparent;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/* ── Message ────────────────────────────────────────── */
message {
    background-color: var(bg-input);
    border-radius:    12px;
    padding:          8px 12px;
    margin:           4px 0px 0px 0px;
}

textbox {
    background-color: transparent;
    text-color:       var(fg-dim);
}
