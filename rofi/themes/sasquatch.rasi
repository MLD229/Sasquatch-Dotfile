@import "colors.rasi"
/* ── Global ─────────────────────────────────────────── */
* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       var(fg);
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ── Window ───────────────────────────────────────────
   Fond quasi opaque : lisible sur un wallpaper clair comme
   sombre (le flou de Hyprland reste visible sur les bords). */
window {
    width:            680px;
    location:         center;
    anchor:           center;
    background-color: rgba(1, 22, 26, 0.97);
    border-radius:    20px;
    border:           1px;
    border-color:     var(border);
    padding:          14px;
}

/* ── Main Box ───────────────────────────────────────── */
mainbox {
    background-color: transparent;
    spacing:          10px;
    /* PAS de `children:` explicite ici : avec [inputbar, listview] le modi
       natif « calc » (plugin rofi-calc) perd sa ligne « Result: … » — mesuré.
       L'ordre par défaut (inputbar, message, listview) l'affiche. */
}

/* ── Input Bar ──────────────────────────────────────── */
inputbar {
    background-color: rgba(1, 37, 44, 0.95);
    border-radius:    12px;
    padding:          11px 14px;
    spacing:          8px;
    children:         [ prompt, textbox-prompt-colon, entry ];
}

prompt {
    background-color: transparent;
    text-color:       var(accent);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       var(accent-dim);
    str:              "›";
    expand:           false;
    margin:           0px 6px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       var(fg);
}

/* ── List View ──────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:          1;
    lines:            11;
    spacing:          3px;
    scrollbar:        false;
    dynamic:          true;
}

/* ── List Element ───────────────────────────────────── */
element {
    background-color: transparent;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          10px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    text-color: var(fg);
}

/* Sélection : teal plein + texte blanc gras = contraste net
   sur n'importe quel fond derrière la fenêtre. */
element selected.normal {
    background-color: rgba(6, 102, 120, 0.90);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

element normal.urgent,
element alternate.urgent {
    text-color: var(urgent);
}

element selected.urgent {
    background-color: rgba(243, 139, 168, 0.85);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

element normal.active,
element alternate.active {
    text-color: var(fg);
}

element selected.active {
    background-color: rgba(6, 102, 120, 0.90);
    text-color:       var(fg-selected);
    font:             "JetBrainsMono Nerd Font Bold 11";
}

/* ── Icon ───────────────────────────────────────────── */
element-icon {
    background-color: transparent;
    size:             24px;
}

/* ── Text ───────────────────────────────────────────── */
element-text {
    background-color: transparent;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/* ── Message ────────────────────────────────────────── */
message {
    background-color: rgba(1, 37, 44, 0.95);
    border-radius:    12px;
    padding:          8px 12px;
    margin:           4px 0px 0px 0px;
}

textbox {
    background-color: transparent;
    text-color:       var(fg-dim);
}
