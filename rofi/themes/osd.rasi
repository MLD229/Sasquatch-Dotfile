@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color: var(fg);
}

window {
    width: 340px;
    location: center;
    anchor: center;
    y-offset: 160px;
    background-color: var(bg-window);
    border-radius: 16px;
    border: 1px;
    border-color: var(border);
    padding: 14px;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

listview {
    background-color: transparent;
    lines: 2;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 4px 8px;
}

element selected {
    background-color: transparent;
    text-color: var(fg);
}
