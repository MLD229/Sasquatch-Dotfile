# Sasquatch-Dotfile — fichiers spécifiques à la machine / artefacts
fish/fish_variables
__pycache__/
*.pyc
# fcitx5 : cache des layouts généré au runtime
fcitx5/conf/cached_layouts
# cc : palette générée par theme-apply.py à chaque changement de wallpaper
cc/qml/Palette.qml

# aiko : modèles GGUF (2.6 Go !) — téléchargés par aiko/setup.sh, jamais versionnés
aiko/models/*.gguf
aiko/sessions/*.json
aiko/server.log

# playlist : dossier musique mémorisé (fichier d'état runtime, choisi par l'utilisateur)
settings/playlist_folder

# Sasquatch-Files : config locale Obsidian (workspace, graph) — pas à versionner
Sasquatch-Files/.obsidian/

# debug : outils de diagnostic locaux, jamais versionnés
scripts/watch-theme.sh
# éditeurs : fichiers d'échange Kate (kate-swp) laissés à la racine du dépôt
*.kate-swp
# Obsidian ouvert directement sur la racine du dépôt (config locale)
/.obsidian/

# subpage : captures et sorties des preuves (tests/verify.sh)
subpage/tests/out/
