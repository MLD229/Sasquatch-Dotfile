{
    "widgets": [
        {
            "id": "clock",
            "name": "Horloge",
            "component": "ClockWidget.qml",
            "hosts": ["background", "cc", "bar", "subpage"],
            "variants": {
                "compact": { "w": 220, "h": 64, "cell": [4, 1] },
                "normal": { "w": 360, "h": 180, "cell": [4, 2] },
                "hero": { "w": 560, "h": 260, "cell": [8, 2] }
            },
            "defaultVariant": "normal",
            "live": true,
            "style": {
                "alpha": [0.03, 0.35],
                "blur": [0, 20],
                "radius": [0, 24],
                "accent": ["auto", "primary", "secondary", "text"]
            },
            "options": {
                "mode": { "type": "enum", "values": ["digital", "analog", "kana"], "default": "digital" },
                "showSeconds": { "type": "bool", "default": true },
                "hour24": { "type": "bool", "default": true }
            }
        },
