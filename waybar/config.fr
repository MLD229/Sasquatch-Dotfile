{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "custom/fastview",
        "hyprland/workspaces",
        "custom/separator",
        "mpris"
    ],
    "modules-center": [
        "custom/clock-ja"
    ],
    "modules-right": [
        "custom/separator",
        "cpu",
        "custom/dot",
        "custom/gpu",
        "custom/dot",
        "memory",
        "custom/dot",
        "network",
        "custom/dot",
        "battery",
        "custom/dot",
        "pulseaudio",
        "custom/dot",
        "custom/brightness",
        "custom/dot",
        "custom/clipboard",
        "custom/dot",
        "bluetooth",
        "custom/separator",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 10
        },
        "on-click": "activate",
        "sort-by-number": true,
        "tooltip": true,
        "tooltip-format": "Espace de travail {name} — workspace {id}\n{windows}",
        "format-window-separator": "\n",
        "window-rewrite-default": "󰘔  {title}",
        "window-rewrite": {
            "class<firefox>":       "󰈹  Firefox",
            "class<chromium>":      "󰊯  Chromium",
            "title<.*YouTube.*>":   "󰗃  YouTube",
            "class<kitty>":         "󰄛  Terminal",
            "class<alacritty>":     "󰄛  Alacritty",
            "class<foot>":          "󰄛  Foot",
            "class<code>":          "󰨞  VSCode",
            "class<code-oss>":      "󰨞  VSCode",
            "class<nvim>":          "  Neovim",
            "class<thunar>":        "󰉋  Thunar",
            "class<nautilus>":      "󰉋  Files",
            "class<nemo>":          "󰉋  Nemo",
            "class<discord>":       "󰙯  Discord",
            "class<vesktop>":       "󰙯  Vesktop",
            "class<spotify>":       "󰎇  Spotify",
            "class<vlc>":           "󰕼  VLC",
            "class<mpv>":           "󰎁  MPV",
            "class<obs>":           "󰖌  OBS",
            "class<gimp>":          "󰠌  GIMP",
            "class<inkscape>":      "󰽉  Inkscape",
            "class<steam>":         "󰓓  Steam",
            "class<lutris>":        "󰺿  Lutris",
            "class<blender>":       "󰂫  Blender",
            "class<libreoffice.*>": "󰈙  LibreOffice"
        }
    },

    "custom/fastview": {
        "exec": "python3 ~/.config/waybar/scripts/fastview.py",
        "format": "{}",
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {artist} — {title}",
        "interval": 2,
        "max-length": 40,
        "tooltip": true,
        "tooltip-format": "Musique — musique\n{artist} — {title}"
    },

    "custom/clock-ja": {
        "exec": "python3 ~/.config/waybar/scripts/clock-ja.py",
        "interval": 30,
        "return-type": "json",
        "tooltip": true
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠 CPU {usage}%",
        "tooltip-format": "CPU {usage}% — processeur à {usage}%\nCœurs: {load}"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{printf \"%s%% %s°C\", $1, $2}'",
        "format": "󰾲 GPU {}",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "GPU {} — carte graphique"
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 RAM {percentage}%",
        "tooltip-format": "RAM {used:.1f} Go / {total:.1f} Go — {percentage}% utilisée\nSwap {swapUsed:.1f} Go / {swapTotal:.1f} Go"
    },

    "network": {
        "format-wifi":        "󰤨 WiFi {signalStrength}%",
        "format-disconnected": "󰤭 Hors ligne",
        "format-ethernet":    "󰈀 Ethernet",
        "tooltip-format":     "WiFi — wifi\n{essid}\n{ipaddr}/{cidr}\n󰕒 ↑{bandwidthUpBytes}  ↓{bandwidthDownBytes}"
    },

    "battery": {
        "interval": 30,
        "format": "{icon} Batterie {capacity}%",
        "format-charging": "󰂄 Batterie {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "Batterie {capacity}% — batterie\nTemps restant: {time}"
    },

    "pulseaudio": {
        "format": "{icon} Volume {volume}%",
        "format-muted": "󰝟 Volume {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": true,
        "tooltip-format": "Volume {volume}% — volume système"
    },

    "custom/brightness": {
        "exec": "brightnessctl -m | awk -F, '{print $4}' | tr -d '%'",
        "format": "󰃟 Luminosité {}%",
        "interval": 2,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": true,
        "tooltip-format": "Luminosité {}% — luminosité"
    },

    "bluetooth": {
        "format":                                     "󰂯",
        "format-disabled":                            "󰂲",
        "format-off":                                 "󰂲",
        "format-connected":                           "󰂱  {num_connections}",
        "format-connected-battery":                   "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format":                             "Bluetooth — bluetooth\n{controller_alias}  {controller_address}\n\n{num_connections} connectés",
        "tooltip-format-connected":                   "Bluetooth · {num_connections} connectés\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected":         "  {device_alias}  {device_address}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias}  {device_address}  {device_battery_percentage}%",
        "on-click":       "blueman-manager",
        "on-click-right": "bluetoothctl power off"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip": true,
        "tooltip-format": "Presse-papier — presse-papier\nClic gauche → sélectionner\nClic droit → vider l'historique\nClic milieu → dernier élément",
        "on-click":        "~/.config/scripts/clipboard.sh",
        "on-click-right":  "cliphist wipe && notify-send '󰅍 Presse-papier' 'Historique vidé'",
        "on-click-middle": "cliphist list | head -1 | cliphist decode | wl-copy && notify-send '󰅍 Presse-papier' 'Dernier élément copié'"
    },

    "tray": {
        "spacing": 8
    },

    "custom/dot": {
        "format": "●",
        "tooltip": false
    },
    "custom/separator": {
        "format": "  ",
        "tooltip": false
    }
}
