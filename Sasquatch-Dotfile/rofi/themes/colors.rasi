/* === SASQUATCH-PALETTE-BEGIN === */
* {
    /* ── Backgrounds ────────────────────────────────── */
    bg-window:   rgba(15, 15, 25, 0.85);
    bg-input:    rgba(30, 30, 46, 0.80);
    bg-selected: rgba(136, 170, 238, 0.25);
    urgent-bg:   rgba(243, 139, 168, 0.25);

    /* ── Foregrounds ────────────────────────────────── */
    fg:          rgba(205, 214, 244, 1.0);
    fg-dim:      rgba(108, 112, 134, 1.0);
    fg-selected: rgba(255, 255, 255, 1.0);

    /* ── Accents ────────────────────────────────────── */
    accent:      rgba(136, 170, 238, 1.0);
    accent-dim:  rgba(136, 170, 238, 0.75);
    urgent:      rgba(243, 139, 168, 1.0);

    /* ── Border ─────────────────────────────────────── */
    border:      rgba(136, 170, 238, 0.50);
}
/* === SASQUATCH-PALETTE-END === */
