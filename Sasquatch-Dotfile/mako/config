# === SASQUATCH-PALETTE-BEGIN ===
sort=-time
layer=overlay
background-color=#201012cc
text-color=#e0cacc
width=340
height=120
border-size=1
border-color=#bf616a44
border-radius=12
padding=12
margin=10
icons=1
max-icon-size=32

font=JetBrains Mono 12
format=<b>%s</b>\n%b

default-timeout=4000
ignore-timeout=0

[urgency=low]
