{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "hyprland/workspaces",
        "custom/separator",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/separator",
        "cpu",
        "custom/dot",
        "custom/gpu",
        "custom/dot",
        "memory",
        "custom/dot",
        "network",
        "custom/dot",
        "battery",
        "custom/dot",
        "pulseaudio",
        "custom/dot",
        "custom/brightness",
        "custom/dot",
        "custom/clipboard",
        "custom/dot",
        "bluetooth",
        "custom/separator",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "persistent-workspaces": {
            "*": 10
        },
        "on-click": "activate",
        "sort-by-number": true,
        "tooltip": true,
        "tooltip-format": "  Workspace {name}\n{windows}",
        "format-window-separator": "\n",
        "window-rewrite-default": "󰘔  {title}",
        "window-rewrite": {
            "class<firefox>":       "󰈹  Firefox",
            "class<chromium>":      "󰊯  Chromium",
            "title<.*YouTube.*>":   "󰗃  YouTube",
            "class<kitty>":         "󰄛  Terminal",
            "class<alacritty>":     "󰄛  Alacritty",
            "class<foot>":          "󰄛  Foot",
            "class<code>":          "󰨞  VSCode",
            "class<code-oss>":      "󰨞  VSCode",
            "class<nvim>":          "  Neovim",
            "class<thunar>":        "󰉋  Thunar",
            "class<nautilus>":      "󰉋  Files",
            "class<nemo>":          "󰉋  Nemo",
            "class<discord>":       "󰙯  Discord",
            "class<vesktop>":       "󰙯  Vesktop",
            "class<spotify>":       "󰎇  Spotify",
            "class<vlc>":           "󰕼  VLC",
            "class<mpv>":           "󰎁  MPV",
            "class<obs>":           "󰖌  OBS",
            "class<gimp>":          "󰌠  GIMP",
            "class<inkscape>":      "󰽉  Inkscape",
            "class<steam>":         "󰓓  Steam",
            "class<lutris>":        "󰺿  Lutris",
            "class<blender>":       "󰂫  Blender",
            "class<libreoffice.*>": "󰈙  LibreOffice"
        }
    },

    "mpris": {
        "format": "{player_icon} {artist} — {title}",
        "interval": 2,
        "max-length": 40,
        "tooltip": true
    },

    "clock": {
        "format": "󰥔  {:%H:%M   %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠  {usage}%",
        "tooltip-format": "CPU: {usage}%\nCœurs: {load}"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{printf \"%s%% %s°C\", $1, $2}'",
        "format": "󰾲  {}",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "RAM: {used:.1f} Go / {total:.1f} Go\nSwap: {swapUsed:.1f} Go / {swapTotal:.1f} Go"
    },

    "network": {
        "format-wifi":        "󰤨  {signalStrength}%",
        "format-disconnected": "󰤭  Off",
        "format-ethernet":    "󰈀  LAN",
        "tooltip-format":     "󰤨  {essid}\n󰩟  {ipaddr}/{cidr}\n󰕒  ↑{bandwidthUpBytes}  ↓{bandwidthDownBytes}"
    },

    "battery": {
        "interval": 30,
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "Batterie: {capacity}%\nTemps restant: {time}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },

    "custom/brightness": {
        "exec": "brightnessctl -m | awk -F, '{print $4}' | tr -d '%'",
        "format": "󰃟 {}%",
        "interval": 2,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "bluetooth": {
        "format":                                     "󰂯",
        "format-disabled":                            "󰂲",
        "format-off":                                 "󰂲",
        "format-connected":                           "󰂱  {num_connections}",
        "format-connected-battery":                   "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format":                             "Bluetooth\n{controller_alias}  {controller_address}\n\n{num_connections} appareil(s) connecté(s)",
        "tooltip-format-connected":                   "Bluetooth  ·  {num_connections} connecté(s)\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected":         "  {device_alias}  {device_address}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias}  {device_address}  {device_battery_percentage}%",
        "on-click":       "blueman-manager",
        "on-click-right": "bluetoothctl power off"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip": true,
        "tooltip-format": "Presse-papier\nClic gauche  → sélectionner\nClic droit   → vider l'historique\nClic milieu  → dernier élément",
        "on-click":        "cliphist list | rofi -dmenu -p 'Presse-papier' -theme ~/.config/rofi/themes/sasquatch.rasi | cliphist decode | wl-copy",
        "on-click-right":  "cliphist wipe && notify-send '󰅍 Presse-papier' 'Historique vidé'",
        "on-click-middle": "cliphist list | head -1 | cliphist decode | wl-copy && notify-send '󰅍 Presse-papier' 'Dernier élément copié'"
    },

    "tray": {
        "spacing": 8
    },

    "custom/dot": {
        "format": "●",
        "tooltip": false
    },
    "custom/separator": {
        "format": "  ",
        "tooltip": false
    }
}
