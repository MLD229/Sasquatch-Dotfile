# === SASQUATCH-PALETTE-BEGIN ===
sort=-time
layer=overlay
background-color=#1a150acc
text-color=#d9d0bd
width=340
height=120
border-size=1
border-color=#2d81fb44
border-radius=12
padding=12
margin=10
icons=1
max-icon-size=32

font=JetBrains Mono 12
format=<b>%s</b>\n%b

default-timeout=4000
ignore-timeout=0

[urgency=low]
background-color=#1a150abb
border-color=#6c708644
text-color=#837b6c

[urgency=normal]
background-color=#1a150acc
border-color=#2d81fb44

[urgency=high]
background-color=#1a150acc
border-color=#f38ba8aa
text-color=#f38ba8
# === SASQUATCH-PALETTE-END ===
