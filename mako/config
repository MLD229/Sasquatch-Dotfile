# === SASQUATCH-PALETTE-BEGIN ===
sort=-time
layer=overlay
background-color=#181415cc
text-color=#d5ced0
width=340
height=120
border-size=1
border-color=#dcaaa144
border-radius=12
padding=12
margin=10
icons=1
max-icon-size=32

font=JetBrains Mono 12
format=<b>%s</b>\n%b

default-timeout=4000
ignore-timeout=0

[urgency=low]
background-color=#181415bb
border-color=#6c708644
text-color=#7f7a7b

[urgency=normal]
background-color=#181415cc
border-color=#dcaaa144

[urgency=high]
background-color=#181415cc
border-color=#f38ba8aa
text-color=#f38ba8
# === SASQUATCH-PALETTE-END ===
