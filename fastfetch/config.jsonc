// fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Logo = ASCII Arch officiel (builtin fastfetch). Les couleurs du logo
    // suivent le thème dynamique : le bloc SASQUATCH-PALETTE est réécrit par
    // theme-apply.py à chaque changement de wallpaper (dégradé de l'accent).
    // Pour tester à la main : fastfetch --logo-type builtin --logo arch
    "logo": {
        "type": "builtin",
        "source": "arch",
        /* === SASQUATCH-PALETTE-BEGIN === */
    "color": {
        "1": "#6b524d",
        "2": "#93706a",
        "3": "#b78d85",
        "4": "#d3aca5",
        "5": "#e7d2ce",
        "6": "#faf6f5"
    }
/* === SASQUATCH-PALETTE-END === */
    },
    "display": {
        "separator": "  →  ",
        "color": "blue"
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": { "output": "cyan" }
        },
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "blue"
        },
        "separator",
        {
            // {name} = modèle court (sans fréquence) → moins large → tient
            // dans une fenêtre étroite sans wrapper.
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "cyan",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰾲 GPU",
            "keyColor": "cyan",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "cyan"
        },
        "separator",
        {
            "type": "uptime",
            "key": "󰥔 Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗 Packages",
            "keyColor": "magenta"
        },
        "separator",
        { "type": "colors", "paddingLeft": 2 }
    ]
}
